# El instalador copia esta plantilla a /etc/estacionamiento/config.env.
# Nunca escriba contraseñas reales dentro del archivo versionado en GitHub.
ESTACIONAMIENTO_DB_HOST=IP_DE_LA_TPV
ESTACIONAMIENTO_DB_USER=Aurelio
ESTACIONAMIENTO_DB_PASSWORD=CONTRASENA_MARIADB
ESTACIONAMIENTO_DB_NAME=Parqueadero1
ESTACIONAMIENTO_PUNTO=tpv
ESTACIONAMIENTO_HOSTNAME=tpv-lab

# Solo se necesitan en la TPV
ESTACIONAMIENTO_SMTP_HOST=SERVIDOR_SMTP
ESTACIONAMIENTO_SMTP_PORT=587
ESTACIONAMIENTO_SMTP_TLS=true
ESTACIONAMIENTO_SMTP_USER=CORREO_ORIGEN
ESTACIONAMIENTO_SMTP_PASSWORD=CONTRASENA_CORREO
ESTACIONAMIENTO_EMAIL_DATABASE=CORREO_DESTINO_BASE
ESTACIONAMIENTO_EMAIL_CORTE=CORREO_DESTINO_CORTES
ESTACIONAMIENTO_EMAIL_NOTIFICACION=CORREO_DESTINO_AVISOS
# Epson por PyUSB: MODE=usb y configure sus identificadores VID/PID.
# POS80 mediante usblp: MODE=lp y DEVICE=/dev/usb/lp0.
ESTACIONAMIENTO_PRINTER_MODE=usb
ESTACIONAMIENTO_PRINTER_DEVICE=/dev/usb/lp0
ESTACIONAMIENTO_PRINTER_VENDOR_ID=04b8
ESTACIONAMIENTO_PRINTER_PRODUCT_ID=0e15
ESTACIONAMIENTO_PASSWORD_PENSIONADOS=CONTRASENA_ADMIN_PENSIONADOS
ESTACIONAMIENTO_ADMIN_USER=USUARIO_ADMINISTRADOR
ESTACIONAMIENTO_ADMIN_PASSWORD=CONTRASENA_ADMINISTRADOR

# Configuración de la pantalla gráfica de Raspberry Pi OS
DISPLAY=:0
